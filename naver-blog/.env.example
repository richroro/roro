# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# --- 글 생성 (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...
# 모델을 바꾸려면 (기본 claude-opus-5). 예: claude-sonnet-5
# ANTHROPIC_MODEL=claude-opus-5
# 생성 품질/비용 조절 (low|medium|high|xhigh|max, 기본 high)
# ANTHROPIC_EFFORT=high
# 안전 분류기 거절 시 대체 모델로 이어서 처리하는 서버 옵션. 끄려면 0
# ANTHROPIC_FALLBACKS=1

# 글의 시점과 톤을 일정하게 하는 블로그 소개 (선택)
# BLOG_PERSONA=30대 직장인이 운영하는 재테크·자동화 블로그. 직접 해본 것만 씀.
# 주요 독자 (선택)
# BLOG_AUDIENCE=재테크를 시작하는 20~30대 직장인

# --- 네이버 블로그 발행 (크롬 자동화) ---
# 블로그 아이디 (blog.naver.com/여기 부분). 보통 네이버 아이디와 같다.
NAVER_BLOG_ID=your_naver_id
# 자동 로그인을 쓰려면 (선택). 비우면 크롬 창에서 직접 로그인 → 세션이 profile/ 에 저장돼 다음부터 자동.
# NAVER_ID=your_naver_id
# NAVER_PW=your_password

# 기본 카테고리 이름 (선택, 비우면 블로그 기본 카테고리)
# NAVER_CATEGORY=일상
# PC에 설치된 크롬을 쓰려면 chrome (Playwright 내장 크로미움 대신). msedge 도 가능
# NAVER_BROWSER_CHANNEL=chrome
# 창을 띄우지 않고 실행 (로그인 세션이 있어야 함). 네이버가 막을 수 있어 기본은 창 띄움
# NAVER_HEADLESS=0
# 소제목을 굵게 (Ctrl+B). 문제가 생기면 0
# NAVER_BOLD_HEADINGS=1
# 문단 입력 사이 지연(ms), 동작 사이 지연(ms)
# NAVER_TYPING_DELAY_MS=0
# NAVER_SLOW_MO=0
