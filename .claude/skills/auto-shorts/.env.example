# auto-shorts API 키 (전부 선택). 이 파일을 .env 로 복사해 값을 채우면 자동으로 읽는다.
# 키가 없어도 Pollinations(AI 이미지)·Edge TTS·Openverse·위키미디어·로컬 합성 BGM 으로 완성된다.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
JAMENDO_CLIENT_ID=
FREESOUND_API_KEY=
POLLINATIONS_TOKEN=

# AI 영상 생성(선택, 유료) — scripts/higgsfield.py
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MODEL=
