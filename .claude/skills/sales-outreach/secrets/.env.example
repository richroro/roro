# sales-outreach 발송 설정 — 이 파일을 .env 로 복사해 값을 채우세요.
# (secrets/ 는 git 에 올리지 마세요.)

# 네이버 메일 기준. 다른 메일이면 호스트/포트만 바꾸면 됩니다.
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=from0731@naver.com
# 네이버 2단계 인증 → '애플리케이션 비밀번호' 로 발급한 값 (로그인 비번 아님)
SMTP_PASSWORD=여기에_앱_비밀번호

# 보내는 사람 표시 이름 / 회신 받을 주소
FROM_NAME=김병채
REPLY_TO=from0731@naver.com

# (선택) Slack 알림 대상을 slackbot/.env 대신 직접 지정하고 싶을 때
# SLACK_USER_ID=U0XXXXXXX

# 참고 — 다른 메일 서비스 SMTP
# Gmail : SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (앱 비밀번호 필요)
# 다음  : SMTP_HOST=smtp.daum.net   SMTP_PORT=465
# 구글워크스페이스: smtp.gmail.com  465
