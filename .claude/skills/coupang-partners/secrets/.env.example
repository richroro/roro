# 쿠팡 파트너스 Open API 키 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 발급 위치: https://partners.coupang.com → 링크 생성 → API (최종 승인 계정만 가능)
# 이 secrets/ 폴더는 .gitignore 로 git 에서 제외됩니다. 키는 비밀번호처럼 취급하세요.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 링크에 붙는 채널 구분값(subId). 리포트에서 어느 채널 링크로 팔렸는지 구분할 때 씁니다.
# 영문/숫자만, 예: blog / threads / movie
COUPANG_SUB_ID=blog
