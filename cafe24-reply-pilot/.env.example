# ---- 서버 ----
PORT=3000
# 카페24 개발자센터에 등록한 앱 URL/Redirect URL의 기준 주소 (https 필수, 로컬은 http 허용)
APP_BASE_URL=http://localhost:3000
# 세션 쿠키 서명 키 (32자 이상 무작위 문자열 권장)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- 카페24 앱 (개발자센터 > 앱 > 인증 정보) ----
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 설치 시 요청할 권한. 주문 조회(mall.read_order)는 "배송 언제 오나요" 답변에 사용됩니다.
CAFE24_SCOPES=mall.read_community,mall.write_community,mall.read_product,mall.read_order,mall.read_store
# (선택) Admin API 버전 고정. 비우면 앱의 기본 버전을 사용합니다. 예: 2025-06-01
CAFE24_API_VERSION=
# (선택) 로컬 개발용 가짜 카페24 서버 주소. 운영에서는 반드시 비워 두세요.
# CAFE24_API_HOST=http://localhost:4000
# 앱 실행 URL의 timestamp 허용 오차(초). 카페24 기본 권장값 2시간.
CAFE24_LAUNCH_MAX_SKEW_SEC=7200

# ---- AI ----
# claude | mock  (비우면 ANTHROPIC_API_KEY가 있을 때 claude, 없으면 mock)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high  (답변 초안은 medium이면 충분합니다)
AI_EFFORT=medium
# 안전 분류기 거절 시 서버측 대체 모델로 자동 재시도 (default | off)
AI_FALLBACKS=default

# ---- 동작 ----
DB_PATH=./data/reply-pilot.db
# 미답변 글 폴링 주기(초). 웹훅이 설정돼 있어도 안전망으로 동작합니다. 0이면 비활성.
POLL_INTERVAL_SEC=300
# 한 번의 동기화에서 AI 초안을 생성할 최대 글 수 (비용 상한)
MAX_DRAFTS_PER_SYNC=20
# 웹훅 서명 검증 필수 여부 (운영: true)
WEBHOOK_REQUIRE_SIGNATURE=true
